# ChefCloud Configuration
# Скопируй этот файл в .env.local и заполни значения

# ════════════════════════════════════════════════════════════════
# SERVER
# ════════════════════════════════════════════════════════════════

# Port для Express сервера (default: 3001)
PORT=3001

# Environment: development | production
NODE_ENV=production

# ════════════════════════════════════════════════════════════════
# DATABASE & STORAGE (optional)
# ════════════════════════════════════════════════════════════════

# Supabase (optional). Без этого используется только localStorage.
# Получи на https://supabase.com
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ════════════════════════════════════════════════════════════════
# AI PROVIDER (для будущих API endpoints)
# ════════════════════════════════════════════════════════════════

# OpenAI (рекомендуется для vision support)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Anthropic (резервный)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
